# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me
# Used by `next dev`, prisma CLI and tests. Inside Docker the app gets its own value from compose.yaml.
DATABASE_URL=postgresql://hydro:change-me@127.0.0.1:5432/hydro
# Required when served over plain HTTP on the LAN (compose sets it for the container).
AUTH_TRUST_HOST=true

# Backups: one dump a day into BACKUP_DIR, keeping the last BACKUP_KEEP_DAYS days.
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14

# Port the app is served on, on the farm network.
# APP_PORT=3000

# Keep the app off the farm network (only the tunnel reaches it): APP_BIND=127.0.0.1
# APP_BIND=0.0.0.0

# Reaching the app from outside (see README): the tunnel token from Cloudflare Zero Trust, and the public address.
# TUNNEL_TOKEN=
